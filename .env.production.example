# Production template. Copy to .env on the server and replace every value.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/learnova_suite?schema=public"
JWT_SECRET="replace-with-a-long-random-production-secret"
SETTINGS_ENCRYPTION_KEY="replace-with-a-32-plus-character-random-settings-secret"
TOTP_ENCRYPTION_KEY="replace-with-exactly-32-utf8-bytes-or-64-hex-characters"
CONTENT_PROTECTION_SECRET="replace-with-a-32-plus-character-random-media-secret"
# Optional. Leave empty to auto-detect the current domain, or set a fixed HTTPS URL behind proxies/CDNs.
NEXT_PUBLIC_APP_URL=""
NEXT_PUBLIC_IOS_APP_URL=""
NEXT_PUBLIC_ANDROID_APP_URL=""
PLATFORM_COMMISSION_PERCENT="15"
BASE_URL="https://your-domain.com"
DEMO_PASSWORD=""

# Keep demo/sandbox features off in production.
DEMO_MODE="false"
PAYMENT_SANDBOX_MODE="false"
ALLOW_PRODUCTION_DEMO_PAYMENTS="false"
STORAGE_PROVIDER="s3"
ALLOW_LOCAL_UPLOADS="false"
MEDIA_ALLOWED_HOSTS="your-cdn-domain.com,iframe.mediadelivery.net"
EMBED_FRAME_ANCESTORS="'self' https://trusted-partner-domain.com"
S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_BASE_URL=""
BACKUP_STORAGE_PROVIDER="s3"
BACKUP_RETENTION_DAYS="14"
REDIS_URL=""

WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET=""
LICENSE_ACTIVATION_SECRET=""

STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_PUBLIC_CERT=""
PAYPAL_MODE="live"
PAYPAL_BASE_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_STARTTLS="true"
SMTP_FROM="no-reply@your-domain.com"
SMTP_USER=""
SMTP_PASS=""
SMTP_EHLO_DOMAIN="your-domain.com"
EMAIL_PROVIDER="smtp"
EMAIL_THROW_ON_FAIL="false"

# Optional Bunny Stream video provider.
BUNNY_API_KEY=""
BUNNY_LIBRARY_ID=""
BUNNY_CDN_HOSTNAME=""
BUNNY_TOKEN_AUTH_KEY=""
BUNNY_WEBHOOK_SECRET=""

