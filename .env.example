# Buyer environment example.
# Copy this file to .env for a clean local/server setup. Use .env.demo.example only for reviewer preview data.
DATABASE_URL="file:./dev.db"
# Header with the real client IP when behind a CDN/proxy (e.g. "cf-connecting-ip" or "x-real-ip").
# Leave empty to use the last X-Forwarded-For hop added by your reverse proxy.
CLIENT_IP_HEADER=""
JWT_SECRET="replace-with-a-long-random-secret-before-launch"
SETTINGS_ENCRYPTION_KEY="replace-with-a-32-plus-character-random-settings-secret"
TOTP_ENCRYPTION_KEY="replace-with-exactly-32-utf8-bytes-or-64-hex-characters"
CONTENT_PROTECTION_SECRET="replace-with-a-32-plus-character-random-media-secret"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_IOS_APP_URL=""
NEXT_PUBLIC_ANDROID_APP_URL=""
PLATFORM_COMMISSION_PERCENT="15"
BASE_URL="http://127.0.0.1:3000"
DEMO_PASSWORD=""

# Production-facing defaults. Enable preview settings only in .env.demo.example.
DEMO_MODE="false"
PAYMENT_SANDBOX_MODE="false"
ALLOW_PRODUCTION_DEMO_PAYMENTS="false"
STORAGE_PROVIDER="local"
ALLOW_LOCAL_UPLOADS="true"
MEDIA_ALLOWED_HOSTS="interactive-examples.mdn.mozilla.net,iframe.mediadelivery.net"

# Replace all of these before production.
WEBHOOK_SECRET=""
STRIPE_WEBHOOK_SECRET=""
LICENSE_ACTIVATION_SECRET=""

# Optional provider keys.
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_WEBHOOK_ID=""
PAYPAL_PUBLIC_CERT=""
PAYPAL_MODE="live"
PAYPAL_BASE_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_STARTTLS="true"
SMTP_FROM=""
SMTP_USER=""
SMTP_PASS=""
SMTP_EHLO_DOMAIN="localhost"
EMAIL_PROVIDER="smtp"
EMAIL_THROW_ON_FAIL="false"

# Optional Bunny Stream video provider.
BUNNY_API_KEY=""
BUNNY_LIBRARY_ID=""
BUNNY_CDN_HOSTNAME=""
BUNNY_TOKEN_AUTH_KEY=""
BUNNY_WEBHOOK_SECRET=""

# Optional OAuth and AI providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
AI_ASSISTANT_ENABLED="false"
AI_PROVIDER=""
AI_MODEL=""
AI_ENDPOINT=""
EMBED_FRAME_ANCESTORS="'self'"
TOTP_ISSUER="Learnova Suite"

# Additional payment gateways
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""
FLUTTERWAVE_WEBHOOK_SECRET=""
MOLLIE_API_KEY=""
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL=""
PAYMOB_API_KEY=""
PAYMOB_INTEGRATION_ID=""
PAYMOB_IFRAME_ID=""
PAYMOB_HMAC_SECRET=""
TAP_SECRET_KEY=""
HYPERPAY_ACCESS_TOKEN=""
HYPERPAY_ENTITY_ID=""
HYPERPAY_BASE_URL=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
XENDIT_SECRET_KEY=""
XENDIT_WEBHOOK_TOKEN=""
SSLCOMMERZ_STORE_ID=""
SSLCOMMERZ_STORE_PASSWORD=""
SSLCOMMERZ_IS_LIVE="false"
