# Ready-to-run demo configuration for local evaluation.
DATABASE_URL="file:./dev.db"
# Header with the real client IP when behind a CDN/proxy (e.g. "cf-connecting-ip" or "x-real-ip").
# Leave empty to use the last X-Forwarded-For hop added by your reverse proxy.
CLIENT_IP_HEADER=""
JWT_SECRET="demo-only-change-before-production-please-use-a-long-random-secret"
SETTINGS_ENCRYPTION_KEY="demo-only-settings-encryption-change-before-production"
TOTP_ENCRYPTION_KEY="demo-only-totp-encryption-change-before-production"
CONTENT_PROTECTION_SECRET="demo-only-content-protection-change-before-production"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_IOS_APP_URL=""
NEXT_PUBLIC_ANDROID_APP_URL=""
PLATFORM_COMMISSION_PERCENT="15"
BASE_URL="http://127.0.0.1:3000"
DEMO_PASSWORD="password123"

# Demo switches
DEMO_MODE="true"
PAYMENT_SANDBOX_MODE="true"
ALLOW_PRODUCTION_DEMO_PAYMENTS="false"
STORAGE_PROVIDER="local"
ALLOW_LOCAL_UPLOADS="true"
MEDIA_ALLOWED_HOSTS="interactive-examples.mdn.mozilla.net,iframe.mediadelivery.net"

# Demo-safe secrets. Replace all of these before production.
WEBHOOK_SECRET="demo-webhook-secret"
STRIPE_WEBHOOK_SECRET="demo-stripe-webhook-secret"
PAYPAL_WEBHOOK_ID=""
PAYPAL_PUBLIC_CERT=""
LICENSE_ACTIVATION_SECRET="demo-license-secret"

# Optional provider keys. Leave empty for demo sandbox screens.
STRIPE_SECRET_KEY=""
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
PAYPAL_MODE="sandbox"
PAYPAL_BASE_URL=""
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_STARTTLS="true"
SMTP_FROM=""
SMTP_USER=""
SMTP_PASS=""
SMTP_EHLO_DOMAIN="localhost"
EMAIL_PROVIDER="demo"
EMAIL_THROW_ON_FAIL="false"

# Optional Bunny Stream video provider. Leave empty for protected local demo uploads.
BUNNY_API_KEY=""
BUNNY_LIBRARY_ID=""
BUNNY_CDN_HOSTNAME=""
BUNNY_TOKEN_AUTH_KEY=""
BUNNY_WEBHOOK_SECRET=""

# Optional OAuth and AI providers
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""
FACEBOOK_REDIRECT_URI=""
OPENAI_API_KEY=""
OPENROUTER_API_KEY=""
DEEPSEEK_API_KEY=""
AI_ASSISTANT_ENABLED="true"
AI_PROVIDER="demo"
AI_MODEL=""
AI_ENDPOINT=""
EMBED_FRAME_ANCESTORS="'self'"
TOTP_ISSUER="Learnova Suite"

# Additional payment gateways
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
PAYSTACK_SECRET_KEY=""
PAYSTACK_WEBHOOK_SECRET=""
FLUTTERWAVE_SECRET_KEY=""
FLUTTERWAVE_SECRET_HASH=""
